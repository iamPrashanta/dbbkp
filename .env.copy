# Database Configuration
# ==========================================
# These will be used as default values for Prompts
# or will be automatically consumed when using --headless mode
ENV_DB_HOST=localhost
ENV_DB_USER=root
ENV_DB_PASS=myStrong1234567
ENV_DB_NAME=mydb

# ==========================================
# Logging
# ==========================================
ENV_LOG_FILE=./dbbkp-run.log

# ==========================================
# Cloud Storage Credentials
# ==========================================

# 1. AWS S3 Configuration
# Used by: aws s3 cp
ENV_AWS_BUCKET=s3://my-backup-bucket/
ENV_AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
ENV_AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET

# 2. rclone Configuration (Google Drive / Dropbox / Backblaze)
# Used by: rclone copy
# Note: Rclone holds credentials in its own '~/.config/rclone/rclone.conf' file. 
# You just need to specify the Remote name here.
ENV_RCLONE_REMOTE=gdrive:/database-backups/

# ==========================================
# Webhook Notifications
# ==========================================
# Used for automated notifications (Slack / Discord). Include the full webhook URL.
ENV_WEBHOOK_URL=
